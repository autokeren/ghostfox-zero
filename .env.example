# Vultr Serverless Inference API key
# Get it from Vultr Console → Serverless Inference
VULTR_INFERENCE_API_KEY=your_key_here

# Chat model for planning (see https://api.vultrinference.com/v1/models)
INFERENCE_CHAT_MODEL=qwen/qwen3-235b-a22b

# Vision model for screenshot verification
INFERENCE_VISION_MODEL=qwen/qwen3-vl-235b-a22b

# Server port
PORT=3000

# Sandbox limits
SANDBOX_MEMORY=512m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_MS=120000
