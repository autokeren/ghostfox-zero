# Vultr Serverless Inference API key (Vultr Console → Serverless Inference)
VULTR_INFERENCE_API_KEY=your_key_here

# Models (tested & working on Vultr Inference)
# glm-5.3-flash handles BOTH chat (decisions) and vision (verification)
INFERENCE_CHAT_MODEL=glm-5.3-flash
INFERENCE_VISION_MODEL=glm-5.3-flash

# The sandbox is the official Ghostfox container image
# (Firefox engine + Rust MCP runtime) — pulled from GitHub Container Registry.
GHOSTFOX_IMAGE=ghcr.io/autokeren/ghostfox:latest

# Server port
PORT=3000

# Sandbox container limits (per task)
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_MS=300000
