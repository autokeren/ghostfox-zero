# Vultr Serverless Inference API key
# Get it from Vultr Console → Serverless Inference
VULTR_INFERENCE_API_KEY=your_key_here

# Models (tested & working on Vultr Inference)
# glm-5.3-flash handles BOTH chat (planning) and vision (screenshot verification)
INFERENCE_CHAT_MODEL=glm-5.3-flash
INFERENCE_VISION_MODEL=glm-5.3-flash

# Server port
PORT=3000

# Sandbox limits
SANDBOX_MEMORY=512m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_MS=120000
